--!strict
-- Fixture registry: one module per world, keyed by the world's Id. Each
-- module is GENERATED by that world's kit script (CHUNK_AUTHORING.md
-- convention 7) and lists the world's fixture meshes and every placement.

local registry: { [string]: any } = {}

for _, module in script:GetChildren() do
	if module:IsA("ModuleScript") then
		local fixtures = require(module) :: any
		assert(registry[fixtures.Id] == nil, `duplicate fixtures for world: {fixtures.Id}`)
		registry[fixtures.Id] = fixtures
	end
end

return registry
