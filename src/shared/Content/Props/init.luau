--!strict
-- Ambient-scenery registry: one module per world, keyed by the world's Id.
-- Each module is GENERATED by that world's kit script (CHUNK_AUTHORING.md
-- convention 6) and lists the world's prop library and every placement.

local registry: { [string]: any } = {}

for _, module in script:GetChildren() do
	if module:IsA("ModuleScript") then
		local props = require(module) :: any
		assert(registry[props.Id] == nil, `duplicate props for world: {props.Id}`)
		registry[props.Id] = props
	end
end

return registry
