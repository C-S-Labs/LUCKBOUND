--!strict
-- Prop-scatter registry: one module per world, keyed by the world's Id. Each
-- is GENERATED by that world's kit script and holds the scatter library
-- (Kinds), the pools each set of chunks draws from (Pools) and every chunk's
-- spawn points (Points). ScatterCore turns them into placements per run.

local registry: { [string]: any } = {}

for _, module in script:GetChildren() do
	if module:IsA("ModuleScript") then
		local scatter = require(module) :: any
		assert(registry[scatter.Id] == nil, `duplicate scatter for world: {scatter.Id}`)
		registry[scatter.Id] = scatter
	end
end

return registry
