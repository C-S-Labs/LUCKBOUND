local out = {}
for _, chunk in CHUNKS do
	local c = table.clone(chunk) :: any
	c.WorldId = "ETHEREAL_SCAPE"
	local sanctum = c.Id == "ES_SANCTUM"
	c.SizeX = if sanctum then 320 else 256
	c.SizeY = 256
	c.SizeZ = if sanctum then 320 else 256
	-- Same box convention as Sky Citadel: keel -96, crown +160, walk plane at
	-- the origin -- 32 studs below the box centre.
	c.GroundOffsetY = 96
	-- ASSUMPTION, not yet measured against an imported FBX (this kit has not
	-- been walked in Studio): Sky Citadel and Verdant Valley both authored
	-- +Y = north in Blender and both needed a 180 flip after the -Z-forward
	-- FBX export. This kit used the same export convention, so the same flip
	-- is assumed here. `ChunkLoader.calibrateYaw` measures the real turn per
	-- mesh at load regardless -- this is only the tie-break hint. VERIFY on
	-- first import (docs/biomes/ETHEREAL_SCAPE.md "Next").
	c.MeshYawOffset = 180
	table.insert(out, c)
end
return out
