--!strict
-- Sky Citadel chunk kit. docs/SKY_CITADEL.md is the art direction; the pieces
-- are generated by assets/source/worlds/sky_citadel/build_sky_citadel_kit.py.
--
-- A white futurist citadel broken into floating islands above the cloud deck:
-- crenellated turrets with violet roofs, needle spires ringed by neon halos,
-- and 40-stud skyways between them. Progression, south to north:
--   ENTRY (arrival plaza) → SKYWAY bridges → SPIRE COURT (the Ascent Gate)
--   → BOSS (the Crown Spire arena)
--
-- CONNECTION VOCABULARY -- decided before modelling, per CHUNK_AUTHORING.md
-- "Starting a different world". Deliberately disjoint from Verdant Valley's
-- PATH/WIDE; a test asserts the two sets never overlap.
--   SKYWAY  connective. A 40-stud bridge deck, walk plane at the origin.
--   ASCENT  arena-only. A 72-stud grand approach with glowing kerbs. The
--           Spire Court is the only piece that offers one, so it gates the
--           arena on every seed -- the same emergent rule as VV's Grove.
--
-- Sockets: Facing is degrees, 0 = -Z (north), 90 = +X, 180 = +Z (south),
-- 270 = -X. Offsets are local to the piece, before rotation.
--
-- SIZE: 256 x 256 x 256 for EVERY piece, and that is exact rather than
-- nominal. ChunkLoader sets mesh.Size = (SizeX, SizeY, SizeZ), so a mesh
-- whose bounding box differs is stretched to fit. The generator pins the box:
-- corner beacons touch the tile edges, the keel apex is at -96, and one spire
-- per piece reaches +160. The walk plane (the Blender origin) therefore sits
-- 32 studs BELOW the bounding-box centre -- the number GroundOffsetY will
-- need when the loader grows it (STATUS.md, High). Until then an uploaded
-- piece would sit 32 studs too LOW -- its walk plane at -32 while the socket
-- markers and the neighbouring blockout sit at 0. Nothing is uploaded yet.
--
-- FIRST DELIVERY is the four-piece minimum (ENTRY, PATH_STRAIGHT, the grove-
-- role COURT, BOSS). The 12-16 target arrives as variants once these four
-- have been through the pipeline once.

local function socket(id: string, kind: string, x: number, z: number, facing: number)
	return { Id = id, Kind = kind, OffsetX = x, OffsetY = 0, OffsetZ = z, Facing = facing }
end

local CHUNKS = {
	{
		Id = "SC_ENTRY",
		Role = "ENTRY" :: any,
		AssetKey = "SC_CHUNK_ENTRY",
		-- Octagonal arrival plaza with a landing pad at the centre. The spawn
		-- drops onto the pad, so nothing is built above (0, 0); the south
		-- quarter is kept clear for the return portal.
		Sockets = { socket("north", "SKYWAY", 0, -128, 0) },
		Weight = 1,
		MaxPerLayout = 1,
		EnemyTags = {},
		Tags = { "arrival", "low-density" },
	},
	{
		Id = "SC_PATH_STRAIGHT",
		Role = "PATH" :: any,
		AssetKey = "SC_CHUNK_PATH_STRAIGHT",
		-- A skyway through a gatehouse on a hexagonal pier.
		Sockets = { socket("south", "SKYWAY", 0, 128, 180), socket("north", "SKYWAY", 0, -128, 0) },
		Weight = 40,
		EnemyTags = {},
		Tags = { "bridge", "narrow" },
	},
	{
		Id = "SC_SPIRE_COURT",
		Role = "COMBAT" :: any,
		AssetKey = "SC_CHUNK_SPIRE_COURT",
		-- The grove's role: a walled court with the Sky Fountain, twin crown
		-- spires, and the Ascent Gate on its north side.
		Sockets = { socket("south", "SKYWAY", 0, 128, 180), socket("north", "ASCENT", 0, -128, 0) },
		Weight = 25,
		-- The only ASCENT provider, and ASCENT is what the arena accepts, so
		-- this is always the final piece before the boss and never mid-path.
		MaxPerLayout = 1,
		EnemyTags = {},
		Tags = { "open", "gate-to-boss" },
	},
	{
		Id = "SC_BOSS_CLEARING",
		Role = "BOSS" :: any,
		AssetKey = "SC_CHUNK_BOSS_CLEARING",
		-- The Crown Spire arena: a round floor ringed by obelisks.
		Sockets = { socket("south", "ASCENT", 0, 128, 180) },
		Weight = 1,
		MaxPerLayout = 1,
		EnemyTags = {},
		Tags = { "arena" },
	},
}

local out = {}
for _, chunk in CHUNKS do
	local c = table.clone(chunk) :: any
	c.WorldId = "SKY_CITADEL"
	c.SizeX = 256
	c.SizeY = 256
	c.SizeZ = 256
	table.insert(out, c)
end
return out
